<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F8F9FA">
    
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical" android:background="#FFFFFF" android:elevation="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="MCQ Cycle" android:textColor="#1A1A1A" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/topBar" android:orientation="vertical" android:padding="16dp" android:gravity="center">

        <TextView android:id="@+id/skillStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="মোট MCQ: 0/1000 - Silver হতে আর বাকি: 1000টা" android:textColor="#8A8A8A" android:layout_marginBottom="24dp" />

        <RelativeLayout android:layout_width="240dp" android:layout_height="240dp">
            <ProgressBar android:id="@+id/timerRing" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:progressDrawable="@drawable/progress_ring" android:max="100" android:progress="0" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_centerInParent="true" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="শেষ হতে বাকি" android:textColor="#8A8A8A" />
                <TextView android:id="@+id/timerText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="20:00" android:textColor="#1A1A1A" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/progressText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="প্রশ্ন: 0/100" android:textColor="#8A8A8A" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/cycleText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cycle: 1" android:textColor="#FF8A00" android:textStyle="bold" android:layout_marginTop="4dp" />
            </LinearLayout>
        </RelativeLayout>

        <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="60dp"
            android:text="শুরু করো" android:textColor="#FFFFFF" android:background="@drawable/btn_orange" android:textSize="18sp"
            android:layout_marginTop="40dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" />
            
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="16dp" android:gravity="center" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
            <Button android:id="@+id/btnPause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Pause" android:background="#FFFFFF" android:textColor="#1A1A1A" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnOff" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Off" android:background="#FFFFFF" android:textColor="#1A1A1A" android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
