<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F9FA">
    <LinearLayout android:id="@+id/resultRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
        <TextView android:id="@+id/resTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Cycle পূর্ণ! 100টা MCQ শেষ!" android:textSize="24sp" android:textStyle="bold" android:textColor="#1A1A1A" android:textAlignment="center" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="24dp" android:layout_marginTop="24dp" android:elevation="2dp">
            <TextView android:id="@+id/resRight" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="সঠিক: 0" android:textColor="#1A1A1A" android:textSize="18sp" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/resWrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ভুল: 0" android:textColor="#1A1A1A" android:textSize="18sp" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/resSkip" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Skip: 0" android:textColor="#1A1A1A" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/resCelebration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FF8A00" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="12dp" android:visibility="gone" />
        <Button android:id="@+id/btnNextCycle" android:layout_width="match_parent" android:layout_height="60dp" android:text="Cycle শুরু করো" android:background="@drawable/btn_orange" android:textColor="#FFFFFF" android:layout_marginTop="24dp" />
        <Button android:id="@+id/btnHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Home" android:background="#00000000" android:textColor="#8A8A8A" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
